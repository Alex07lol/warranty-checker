# ── WarrantyVault environment template ──────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env — it holds secrets.
# Safe example values only; see docs/PRODUCTION.md for the full checklist.

# ── Required ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/warrantyvault_db
JWT_SECRET=<your-long-random-secret>
# Duration format: number + s/m/h/d/w/y (e.g. 15m, 7d). Plain numbers or
# "7 days" are rejected at boot.
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
CLIENT_URL=http://localhost

# ── Email Provider (Brevo HTTPS API - Recommended for Render/Cloud) ────────
# Get your free API key at https://app.brevo.com/settings/keys/api (300 free emails/day)
# Brevo sends via HTTPS (port 443), immune to cloud SMTP port blocking.
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_EMAIL=your-verified-brevo-email@gmail.com

# ── Alternative: Gmail SMTP via Nodemailer ──────────────────────────────────
# Note: Render free tier blocks outbound SMTP ports 25/465/587.
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="WarrantyVault <your-email@gmail.com>"

# Google Places API key (repair-centre search, reverse geocoding, photos).
# Without it the Places proxy returns a controlled 503 and Nominatim
# reverse-geocoding still works.
GOOGLE_PLACES_API_KEY=

# Rate-limit tuning (requests per window). Defaults shown; leave unset to use
# them.
AUTH_RATE_LIMIT=10        # auth endpoints, per 15 min
UPLOAD_RATE_LIMIT=10      # document uploads, per minute
OCR_RATE_LIMIT=15         # OCR retries, per 10 min
PLACES_RATE_LIMIT=120     # Places proxy, per 15 min

# Max concurrent OCR jobs (in-process semaphore; 2 is free-tier friendly).
OCR_MAX_CONCURRENT=2
