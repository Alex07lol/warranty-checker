{
  "info": {
    "name": "WarrantyVault API",
    "description": "WarrantyVault Day 2 handoff API collection. Import into Postman, then set the collection variables below:\n\n- baseUrl: http://localhost:5000/api/v1 (Android emulator: http://10.0.2.2:5000/api/v1)\n- token: filled automatically after Register/Login (or paste a JWT manually)\n- productId / documentId / recordId / notificationId: captured automatically in the happy-path flow\n\nSuggested order: 1) Health, 2) Auth > Register, 3) Auth > Login, 4) Products > Create, 5) Products > List, 6) Documents > Upload, 7) Service History > Create, 8) Dashboard > Get, 9) Notifications > List.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "baseHost", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "recordId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseHost}}/health",
              "host": ["{{baseHost}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set(\"token\", json.data.token);",
                  "}",
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"returns token and user\", () => {",
                  "  pm.expect(json.data).to.have.property(\"token\");",
                  "  pm.expect(json.data.user).to.have.property(\"email\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set(\"token\", json.data.token);",
                  "}",
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns token\", () => pm.expect(json.data).to.have.property(\"token\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Change password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newpassword123\",\n  \"confirmNewPassword\": \"newpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-password"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set(\"productId\", json.data._id);",
                  "}",
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Sony WH-1000XM5 Headphones\",\n  \"brand\": \"Sony\",\n  \"model\": \"WH-1000XM5\",\n  \"category\": \"Electronics\",\n  \"purchaseDate\": \"2025-06-01\",\n  \"purchasePrice\": 349.99,\n  \"currency\": \"USD\",\n  \"purchaseStore\": \"Best Buy\",\n  \"serialNumber\": \"SN-1000XM5-001\",\n  \"warrantyExpiryDate\": \"2027-06-01\",\n  \"warrantyPeriodMonths\": 24,\n  \"notes\": \"Flagship noise-cancelling headphones\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "response": []
        },
        {
          "name": "List products (paginated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&sortBy=createdAt&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "order", "value": "desc" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/search?q=headphones",
              "host": ["{{baseUrl}}"],
              "path": ["products", "search"],
              "query": [{ "key": "q", "value": "headphones" }]
            }
          },
          "response": []
        },
        {
          "name": "Expiring soon",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/expiring-soon",
              "host": ["{{baseUrl}}"],
              "path": ["products", "expiring-soon"]
            }
          },
          "response": []
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Updated notes after firmware fix\",\n  \"category\": \"Audio\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete product (soft)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "List documents for product",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "documents"]
            }
          },
          "response": []
        },
        {
          "name": "Upload document (multipart)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set(\"documentId\", json.data._id);",
                  "}",
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                {
                  "key": "documentType",
                  "value": "receipt",
                  "type": "text",
                  "description": "receipt | warranty_card | product_photo | manual | other"
                },
                { "key": "notes", "value": "Original purchase receipt", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "documents"]
            }
          },
          "response": []
        },
        {
          "name": "Get document by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "documents", "{{documentId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete document",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "documents", "{{documentId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Service History",
      "item": [
        {
          "name": "List service history",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/service-history",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "service-history"]
            }
          },
          "response": []
        },
        {
          "name": "Add service record",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set(\"recordId\", json.data._id);",
                  "}",
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceDate\": \"2026-06-15\",\n  \"serviceType\": \"maintenance\",\n  \"serviceProvider\": \"Sony Service Center\",\n  \"cost\": 49.99,\n  \"currency\": \"USD\",\n  \"description\": \"Annual headphone checkup\",\n  \"nextServiceDate\": \"2027-06-15\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/service-history",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "service-history"]
            }
          },
          "response": []
        },
        {
          "name": "Get service record",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/service-history/{{recordId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "service-history", "{{recordId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update service record",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cost\": 59.99,\n  \"description\": \"Checkup plus driver replacement\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/service-history/{{recordId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "service-history", "{{recordId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete service record",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/service-history/{{recordId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "service-history", "{{recordId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            }
          },
          "response": []
        },
        {
          "name": "List unread notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications?unreadOnly=true",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"],
              "query": [{ "key": "unreadOnly", "value": "true" }]
            }
          },
          "response": []
        },
        {
          "name": "Mark notification as read",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "{{notificationId}}", "read"]
            }
          },
          "response": []
        },
        {
          "name": "Mark all as read",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/read-all",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "read-all"]
            }
          },
          "response": []
        },
        {
          "name": "Delete notification",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "{{notificationId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get dashboard data",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
