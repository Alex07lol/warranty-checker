PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/warrantyvault_db?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_string_minimum_64_characters
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CLIENT_URL=http://localhost

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
